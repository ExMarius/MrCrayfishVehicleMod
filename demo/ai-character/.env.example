# Serverul tau Minecraft (paper/vanilla). Pentru test local: 127.0.0.1 si 25565.
MC_HOST=127.0.0.1
MC_PORT=25565
# Versiunea serverului (1.21.1, 1.21.4, 1.20.1 ...)
MC_VERSION=1.21.1

# Numele personajului (apare ca jucator in joc)
BOT_NAME=Uke
# offline = server fara autentificare (online-mode=false); mojang = cont premium
MC_AUTH=offline
# Numele tau de jucator (stapanul caruia i se supune personajul)
OWNER=ExMarius
# 1 = raspunde la orice mesaj din chat, 0 = doar cand e strigat pe nume
RESPOND_ALL=0

# Optional: AI online gratuit (https://console.groq.com -> API Keys).
# Fara cheie, personajul foloseste raspunsuri locale simple.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
