# ===== Serverul tau Minecraft =====
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.21.1
# offline = server cu online-mode=false (recomandat pentru test)
MC_AUTH=offline
# Numele tau de jucator (personajele te urmeaza si iti raspund)
OWNER=ExMarius

# ===== Creierul AI (optional, gratuit) =====
# Fara cheie, personajele raspund local (functioneaza, dar simplu).
# Cheie gratuita: https://console.groq.com -> API Keys
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
